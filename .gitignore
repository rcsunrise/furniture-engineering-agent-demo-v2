# Dependencies (依赖包，文件极多，无需纳入 Git 版本管理)
node_modules/
.pnp
.pnp.js

# Environment variables & local credentials (本地密钥配置，避免泄露)
.env
.env.local
.env.*.local

# Production build outputs (构建产物)
dist/
build/

# Runtime data & uploads (本地上传的临时文件与本地存储)
uploads/
data/
local-worker/temp/
temp/

# Logs (日志)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files (系统与编辑器临时文件)
.vscode/
.idea/
.DS_Store
Thumbs.db
